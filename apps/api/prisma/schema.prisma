// Fripstock schema — see CLAUDE.md for the business rules.
//
// Conventions: models in PascalCase, fields in camelCase, tables and columns in
// snake_case through @@map / @map. Identifiers are English; user-facing text and
// explanatory comments stay French.
//
// Prisma 7: the connection URL no longer lives here but in prisma.config.ts,
// and the client receives a driver adapter (see PrismaService and seed.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // NestJS compiles to CommonJS: without this the client is emitted as ESM and
  // blows up on load ("exports is not defined in ES module scope").
  moduleFormat        = "cjs"
  // Extensionless imports: the client is consumed both compiled (CommonJS
  // resolution) and straight from .ts by ts-node for the seed. A hardcoded
  // ".js" would break the second case.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  /// Dernier numéro attribué aux références d'articles achetés (A-0042).
  /// Incrémenté dans la transaction de création : deux employés qui
  /// enregistrent en même temps ne peuvent pas obtenir le même numéro.
  productCounter Int @default(0) @map("product_counter")

  shops                Shop[]
  users                User[]
  categories           Category[]
  attributeDefinitions AttributeDefinition[]
  statuses             Status[]
  depositors           Depositor[]
  products             Product[]
  notifications        Notification[]

  @@map("company")
}

model Shop {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accesses ShopAccess[]
  products Product[]

  @@index([companyId])
  @@map("shop")
}

model User {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isManager    Boolean  @default(false) @map("is_manager")
  createdAt    DateTime @default(now()) @map("created_at")

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accesses      ShopAccess[]
  statusChanges StatusHistory[]

  @@index([companyId])
  @@map("user")
}

/// One row per shop an employee can reach, holding the permissions granted
/// there. A manager (isManager) never goes through this table.
///
/// No companyId: isolation flows through `user`.
model ShopAccess {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  shopId      String   @map("shop_id")
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
  @@map("shop_access")
}

// ---------------------------------------------------------------------------
// Catalogue: categories and attributes, defined at company level
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  parentId  String?  @map("parent_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Restrict: deleting a category that has children must raise an explicit
  /// error rather than silently take the whole subtree with it.
  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]

  @@index([companyId])
  @@index([parentId])
  @@map("category")
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTISELECT
  BOOLEAN

  @@map("attribute_type")
}

/// Global, read-only library filled by the seed only: no companyId, no company
/// ever edits it.
model AttributeTemplate {
  id   String        @id @default(cuid())
  name String        @unique
  type AttributeType

  options AttributeTemplateOption[]
  clones  AttributeDefinition[]

  @@map("attribute_template")
}

model AttributeTemplateOption {
  id                  String @id @default(cuid())
  attributeTemplateId String @map("attribute_template_id")
  value               String
  position            Int    @default(0)

  template AttributeTemplate @relation(fields: [attributeTemplateId], references: [id], onDelete: Cascade)

  @@unique([attributeTemplateId, value])
  @@index([attributeTemplateId])
  @@map("attribute_template_option")
}

model AttributeDefinition {
  id                   String        @id @default(cuid())
  companyId            String        @map("company_id")
  name                 String
  type                 AttributeType
  clonedFromTemplateId String?       @map("cloned_from_template_id")
  createdAt            DateTime      @default(now()) @map("created_at")

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// SetNull: the clone is independent, losing the template must not take the
  /// company's own attribute with it.
  template   AttributeTemplate?  @relation(fields: [clonedFromTemplateId], references: [id], onDelete: SetNull)
  options    AttributeOption[]
  categories CategoryAttribute[]
  values     AttributeValue[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([clonedFromTemplateId])
  @@map("attribute_definition")
}

model AttributeOption {
  id                    String @id @default(cuid())
  attributeDefinitionId String @map("attribute_definition_id")
  value                 String
  position              Int    @default(0)

  attribute AttributeDefinition      @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  products  ProductAttributeOption[]

  @@unique([attributeDefinitionId, value])
  @@index([attributeDefinitionId])
  @@map("attribute_option")
}

/// Which attributes apply to which category: a bag has no size, a dress does.
model CategoryAttribute {
  categoryId            String @map("category_id")
  attributeDefinitionId String @map("attribute_definition_id")

  category  Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeDefinitionId])
  @@index([categoryId])
  @@index([attributeDefinitionId])
  @@map("category_attribute")
}

// ---------------------------------------------------------------------------
// Statuses
// ---------------------------------------------------------------------------

/// The three behaviour flags drive the business logic independently of the
/// label, which the manager may rename. See CLAUDE.md, "Statuts".
///
/// Exactly one status per company must carry `isDefault`. That is not
/// expressible as a Prisma unique index — one on [companyId, isDefault] would
/// also forbid two `false` — and a hand-written partial index would read as
/// drift to `make check-db`. The rule is held in the statuses service.
model Status {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  color       String   @default("#6b7280")
  position    Int      @default(0)
  isDefault   Boolean  @default(false) @map("is_default")
  isSale      Boolean  @default(false) @map("is_sale")
  blocksSale  Boolean  @default(false) @map("blocks_sale")
  leavesStock Boolean  @default(false) @map("leaves_stock")
  createdAt   DateTime @default(now()) @map("created_at")

  /// Position on the workflow diagram, set with the default flow.
  positionX Float? @map("position_x")
  positionY Float? @map("position_y")

  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products            Product[]
  history             StatusHistory[]
  outgoingTransitions StatusTransition[] @relation("TransitionSource")
  incomingTransitions StatusTransition[] @relation("TransitionTarget")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("status")
}

/// An allowed move from one status to another — the arrows on the diagram.
///
/// While a company has NO transition at all, every move stays allowed:
/// enforcing an empty graph would freeze its whole stock. From the first arrow
/// onwards, only the drawn paths are accepted.
///
/// No companyId: isolation flows through `source`.
model StatusTransition {
  id       String @id @default(cuid())
  sourceId String @map("source_id")
  targetId String @map("target_id")

  source Status @relation("TransitionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Status @relation("TransitionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@map("status_transition")
}

// ---------------------------------------------------------------------------
// Consignment
// ---------------------------------------------------------------------------

model Depositor {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  lastName          String   @map("last_name")
  firstName         String?  @map("first_name")
  email             String?
  phone             String?
  address           String?
  iban              String?
  /// Share the shop keeps, as a percentage. See CLAUDE.md, "Dépôt-vente":
  /// depositorShare = soldPrice * (1 - commission / 100).
  defaultCommission Decimal  @default(0) @map("default_commission") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  /// Code court du déposant dans les références d'articles (le MAR de
  /// D-MAR-001). Déduit du nom à la création, modifiable ensuite : il finit
  /// écrit sur des étiquettes, il ne doit plus bouger tout seul.
  /// Nullable pour les déposants créés avant la génération de références —
  /// leur code est calculé au premier besoin.
  code String?

  /// Dernier numéro attribué à cet déposant. Reparti à 1 pour chacun, pour que
  /// « le 3 de Martin » se dise et se retrouve.
  productCounter Int @default(0) @map("product_counter")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts DepositContract[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("depositor")
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  CLOSED

  @@map("contract_status")
}

/// No companyId: isolation flows through `depositor`. Every query must filter
/// through the parent relation (see CLAUDE.md, coding conventions).
model DepositContract {
  id               String         @id @default(cuid())
  depositorId      String         @map("depositor_id")
  startDate        DateTime       @map("start_date")
  endDate          DateTime       @map("end_date")
  commission       Decimal        @db.Decimal(5, 2)
  notifyBeforeDays Int            @default(7) @map("notify_before_days")
  status           ContractStatus @default(ACTIVE)
  /// Set by the deadline job so it does not notify again every day.
  notifiedAt       DateTime?      @map("notified_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  depositor     Depositor      @relation(fields: [depositorId], references: [id], onDelete: Cascade)
  products      Product[]
  notifications Notification[]

  @@index([depositorId])
  @@index([endDate])
  @@map("deposit_contract")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

enum SaleType {
  /// The shop bought the item and resells it: purchasePrice is relevant.
  RESALE
  /// The item belongs to a depositor through a DepositContract.
  CONSIGNMENT

  @@map("sale_type")
}

model Product {
  id         String  @id @default(cuid())
  companyId  String  @map("company_id")
  /// Nullable: a product may exist at company level before being assigned to a
  /// shop (central stock, waiting to be sorted).
  shopId     String? @map("shop_id")
  categoryId String  @map("category_id")
  statusId   String  @map("status_id")

  /// Generated on creation (A-0042, D-MAR-001) unless typed by hand. `sku` is
  /// reserved for a future QR scan and unused for now.
  reference    String?
  sku          String?
  name         String
  description  String?
  internalNote String? @map("internal_note")
  photoUrl     String? @map("photo_url")

  purchasePrice Decimal? @map("purchase_price") @db.Decimal(10, 2)
  salePrice     Decimal? @map("sale_price") @db.Decimal(10, 2)
  soldPrice     Decimal? @map("sold_price") @db.Decimal(10, 2)
  quantity      Int      @default(1)

  saleType          SaleType  @map("sale_type")
  depositContractId String?   @map("deposit_contract_id")
  /// Frozen copy of DepositContract.commission, taken when the product moves to
  /// a status carrying isSale. Statements, exports and stats read this copy and
  /// never the contract, which may be edited afterwards.
  appliedCommission Decimal?  @map("applied_commission") @db.Decimal(5, 2)
  depositorPaid     Boolean?  @map("depositor_paid")
  soldAt            DateTime? @map("sold_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shop            Shop?            @relation(fields: [shopId], references: [id], onDelete: SetNull)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status          Status           @relation(fields: [statusId], references: [id], onDelete: Restrict)
  depositContract DepositContract? @relation(fields: [depositContractId], references: [id], onDelete: SetNull)

  attributeValues  AttributeValue[]
  attributeOptions ProductAttributeOption[]
  statusHistory    StatusHistory[]

  /// Une référence est ce qui identifie physiquement un article : deux
  /// étiquettes identiques dans la même entreprise sont une erreur, pas un
  /// raccourci. Postgres accepte plusieurs NULL, un article sans référence
  /// reste donc possible.
  @@unique([companyId, reference])
  @@index([companyId])
  @@index([shopId])
  @@index([categoryId])
  @@index([statusId])
  @@index([depositContractId])
  @@index([reference])
  @@map("product")
}

/// Values for TEXT / NUMBER / BOOLEAN attributes.
model AttributeValue {
  id                    String   @id @default(cuid())
  productId             String   @map("product_id")
  attributeDefinitionId String   @map("attribute_definition_id")
  textValue             String?  @map("text_value")
  numberValue           Decimal? @map("number_value") @db.Decimal(12, 3)
  booleanValue          Boolean? @map("boolean_value")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeDefinitionId])
  @@index([productId])
  @@index([attributeDefinitionId])
  @@map("attribute_value")
}

/// Values for SELECT (one row) and MULTISELECT (several) attributes.
model ProductAttributeOption {
  productId         String @map("product_id")
  attributeOptionId String @map("attribute_option_id")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Cascade)

  @@id([productId, attributeOptionId])
  @@index([productId])
  @@index([attributeOptionId])
  @@map("product_attribute_option")
}

model StatusHistory {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  statusId        String   @map("status_id")
  /// Nullable + SetNull: deleting an employee must not erase the trace of the
  /// status changes they made.
  changedByUserId String?  @map("changed_by_user_id")
  changedAt       DateTime @default(now()) @map("changed_at")
  note            String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  status  Status  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  author  User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([statusId])
  @@index([changedByUserId])
  @@map("status_history")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  type              String
  depositContractId String?  @map("deposit_contract_id")
  message           String
  isRead            Boolean  @default(false) @map("is_read")
  createdAt         DateTime @default(now()) @map("created_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  depositContract DepositContract? @relation(fields: [depositContractId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([depositContractId])
  @@map("notification")
}
