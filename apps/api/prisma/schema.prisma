// Schéma Fripstock — voir CLAUDE.md pour les règles métier.
//
// Conventions : modèles en PascalCase français, champs en camelCase français,
// tables et colonnes en snake_case via @@map / @map.
//
// Prisma 7 : l'URL de connexion ne vit plus ici mais dans prisma.config.ts, et
// le client reçoit un adaptateur de driver (voir PrismaService / seed.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // NestJS compile en CommonJS : sans ça le client est généré en ESM et
  // explose au chargement ("exports is not defined in ES module scope").
  moduleFormat        = "cjs"
  // Imports sans extension : le client est consommé à la fois compilé (dist,
  // résolution CommonJS) et directement en .ts par ts-node pour le seed. Un
  // `.js` en dur casserait le second cas.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Entreprise {
  id        String   @id @default(cuid())
  nom       String
  createdAt DateTime @default(now()) @map("created_at")

  boutiques     Boutique[]
  utilisateurs  User[]
  categories    Categorie[]
  attributs     AttributDefinition[]
  statuts       Statut[]
  clients       Client[]
  produits      Produit[]
  notifications Notification[]

  @@map("entreprise")
}

model Boutique {
  id           String   @id @default(cuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  adresse      String?
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise Entreprise      @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  acces      AccesBoutique[]
  produits   Produit[]

  @@index([entrepriseId])
  @@map("boutique")
}

model User {
  id             String   @id @default(cuid())
  entrepriseId   String   @map("entreprise_id")
  email          String   @unique
  motDePasseHash String   @map("mot_de_passe_hash")
  prenom         String
  nom            String
  estGerant      Boolean  @default(false) @map("est_gerant")
  createdAt      DateTime @default(now()) @map("created_at")

  entreprise        Entreprise         @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  acces             AccesBoutique[]
  changementsStatut HistoriqueStatut[]

  @@index([entrepriseId])
  @@map("utilisateur")
}

// Un employé a une ligne par boutique à laquelle il a accès, avec ses
// permissions activées. Le gérant (estGerant) ne passe jamais par cette table.
// Ce modèle n'a pas de entrepriseId : le cloisonnement passe par `user`.
model AccesBoutique {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  boutiqueId  String   @map("boutique_id")
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@unique([userId, boutiqueId])
  @@index([userId])
  @@index([boutiqueId])
  @@map("acces_boutique")
}

// ---------------------------------------------------------------------------
// Catalogue : catégories et attributs, définis au niveau Entreprise
// ---------------------------------------------------------------------------

model Categorie {
  id           String   @id @default(cuid())
  entrepriseId String   @map("entreprise_id")
  parentId     String?  @map("parent_id")
  nom          String
  createdAt    DateTime @default(now()) @map("created_at")

  entreprise Entreprise          @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  // Restrict : supprimer une catégorie qui a des enfants doit lever une erreur
  // explicite côté service, pas emporter tout le sous-arbre en silence.
  parent     Categorie?          @relation("CategorieHierarchie", fields: [parentId], references: [id], onDelete: Restrict)
  enfants    Categorie[]         @relation("CategorieHierarchie")
  attributs  CategorieAttribut[]
  produits   Produit[]

  @@index([entrepriseId])
  @@index([parentId])
  @@map("categorie")
}

enum TypeAttribut {
  TEXT
  NUMBER
  SELECT
  MULTISELECT
  BOOLEAN

  @@map("type_attribut")
}

// Bibliothèque globale, en lecture seule, alimentée par le seed uniquement :
// pas de entrepriseId, aucune entreprise ne la modifie.
model AttributTemplate {
  id   String       @id @default(cuid())
  nom  String       @unique
  type TypeAttribut

  options AttributTemplateOption[]
  clones  AttributDefinition[]

  @@map("attribut_template")
}

model AttributTemplateOption {
  id                 String @id @default(cuid())
  attributTemplateId String @map("attribut_template_id")
  valeur             String
  ordre              Int    @default(0)

  template AttributTemplate @relation(fields: [attributTemplateId], references: [id], onDelete: Cascade)

  @@unique([attributTemplateId, valeur])
  @@index([attributTemplateId])
  @@map("attribut_template_option")
}

model AttributDefinition {
  id                   String       @id @default(cuid())
  entrepriseId         String       @map("entreprise_id")
  nom                  String
  type                 TypeAttribut
  clonedFromTemplateId String?      @map("cloned_from_template_id")
  createdAt            DateTime     @default(now()) @map("created_at")

  entreprise Entreprise          @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  // SetNull : le clone est indépendant, la disparition du template ne doit pas
  // emporter l'attribut personnalisé de l'entreprise.
  template   AttributTemplate?   @relation(fields: [clonedFromTemplateId], references: [id], onDelete: SetNull)
  options    AttributOption[]
  categories CategorieAttribut[]
  valeurs    ValeurAttribut[]

  @@unique([entrepriseId, nom])
  @@index([entrepriseId])
  @@index([clonedFromTemplateId])
  @@map("attribut_definition")
}

model AttributOption {
  id                   String @id @default(cuid())
  attributDefinitionId String @map("attribut_definition_id")
  valeur               String
  ordre                Int    @default(0)

  attribut AttributDefinition      @relation(fields: [attributDefinitionId], references: [id], onDelete: Cascade)
  produits ProduitAttributOption[]

  @@unique([attributDefinitionId, valeur])
  @@index([attributDefinitionId])
  @@map("attribut_option")
}

// Quels attributs s'appliquent à quelle catégorie : "Sac" n'a pas de Taille,
// "Robe" si.
model CategorieAttribut {
  categorieId          String @map("categorie_id")
  attributDefinitionId String @map("attribut_definition_id")

  categorie Categorie          @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  attribut  AttributDefinition @relation(fields: [attributDefinitionId], references: [id], onDelete: Cascade)

  @@id([categorieId, attributDefinitionId])
  @@index([categorieId])
  @@index([attributDefinitionId])
  @@map("categorie_attribut")
}

// ---------------------------------------------------------------------------
// Statuts
// ---------------------------------------------------------------------------

// Les trois flags comportementaux pilotent la logique métier indépendamment du
// libellé, que le gérant peut renommer. Voir CLAUDE.md, section "Statuts".
//
// `estDefaut` doit être vrai pour exactement un statut par entreprise. Ce n'est
// pas exprimable en index unique Prisma (un index sur [entrepriseId, estDefaut]
// interdirait aussi deux `false`), et un index partiel écrit à la main dans la
// migration serait vu comme une dérive par `make check-db`. La contrainte est
// donc tenue au niveau service, dans le module `statuts`.
model Statut {
  id           String   @id @default(cuid())
  entrepriseId String   @map("entreprise_id")
  nom          String
  couleur      String   @default("#6b7280")
  ordre        Int      @default(0)
  estDefaut    Boolean  @default(false) @map("est_defaut")
  estVente     Boolean  @default(false) @map("est_vente")
  bloqueVente  Boolean  @default(false) @map("bloque_vente")
  sortStock    Boolean  @default(false) @map("sort_stock")
  createdAt    DateTime @default(now()) @map("created_at")

  // Position sur le schéma du flux (écran Statuts). Nulles tant que le gérant
  // n'a rien déplacé : l'écran dispose alors les statuts automatiquement.
  positionX Float? @map("position_x")
  positionY Float? @map("position_y")

  entreprise           Entreprise         @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  produits             Produit[]
  historique           HistoriqueStatut[]
  transitionsSortantes TransitionStatut[] @relation("TransitionSource")
  transitionsEntrantes TransitionStatut[] @relation("TransitionCible")

  @@unique([entrepriseId, nom])
  @@index([entrepriseId])
  @@map("statut")
}

/// Transition autorisée d'un statut vers un autre — les flèches du schéma.
///
/// Tant qu'une entreprise n'en a tracé AUCUNE, tous les changements restent
/// permis : imposer un graphe vide bloquerait tout le stock. Dès la première
/// flèche, seules les transitions tracées sont acceptées.
///
/// Pas de entrepriseId : le cloisonnement passe par `source`. Voir la règle de
/// scoping via relation parente dans CLAUDE.md.
model TransitionStatut {
  id       String @id @default(cuid())
  sourceId String @map("source_id")
  cibleId  String @map("cible_id")

  source Statut @relation("TransitionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  cible  Statut @relation("TransitionCible", fields: [cibleId], references: [id], onDelete: Cascade)

  @@unique([sourceId, cibleId])
  @@index([sourceId])
  @@index([cibleId])
  @@map("transition_statut")
}

// ---------------------------------------------------------------------------
// Dépôt-vente
// ---------------------------------------------------------------------------

model Client {
  id               String   @id @default(cuid())
  entrepriseId     String   @map("entreprise_id")
  nom              String
  prenom           String?
  email            String?
  telephone        String?
  adresse          String?
  iban             String?
  // Part que garde la boutique, en pourcentage. Voir CLAUDE.md, section
  // "Dépôt-vente" : partDeposant = prixVendu * (1 - commission / 100).
  commissionDefaut Decimal  @default(0) @map("commission_defaut") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  entreprise Entreprise     @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  contrats   ContratDepot[]

  @@index([entrepriseId])
  @@map("client")
}

enum StatutContrat {
  ACTIF
  EXPIRE
  CLOS

  @@map("statut_contrat")
}

// Pas de entrepriseId : le cloisonnement passe par `client`. Toute requête doit
// filtrer via la relation parente (voir CLAUDE.md, conventions de code).
model ContratDepot {
  id               String        @id @default(cuid())
  clientId         String        @map("client_id")
  dateDebut        DateTime      @map("date_debut")
  dateFin          DateTime      @map("date_fin")
  commission       Decimal       @db.Decimal(5, 2)
  notifyBeforeDays Int           @default(7) @map("notify_before_days")
  statut           StatutContrat @default(ACTIF)
  // Renseigné par le job d'alerte d'échéance pour ne pas renotifier en boucle.
  notifieLe        DateTime?     @map("notifie_le")
  createdAt        DateTime      @default(now()) @map("created_at")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  produits      Produit[]
  notifications Notification[]

  @@index([clientId])
  @@index([dateFin])
  @@map("contrat_depot")
}

// ---------------------------------------------------------------------------
// Produits
// ---------------------------------------------------------------------------

enum TypeVente {
  ACHAT_REVENTE
  DEPOT_VENTE

  @@map("type_vente")
}

model Produit {
  id           String  @id @default(cuid())
  entrepriseId String  @map("entreprise_id")
  // Nullable : un produit peut exister au niveau entreprise avant d'être
  // assigné à une boutique (stock central / à trier).
  boutiqueId   String? @map("boutique_id")
  categorieId  String  @map("categorie_id")
  statutId     String  @map("statut_id")

  // Saisie manuelle et libre (ex: BTR6). `sku` est réservé à un futur scan QR.
  reference   String?
  sku         String?
  nom         String
  description String?
  commentaire String?
  photoUrl    String? @map("photo_url")

  prixAchat Decimal? @map("prix_achat") @db.Decimal(10, 2)
  prixVente Decimal? @map("prix_vente") @db.Decimal(10, 2)
  prixVendu Decimal? @map("prix_vendu") @db.Decimal(10, 2)
  quantite  Int      @default(1)

  typeVente           TypeVente @map("type_vente")
  contratDepotId      String?   @map("contrat_depot_id")
  // Copie figée de ContratDepot.commission au passage à un statut estVente.
  // C'est elle que lisent le relevé, l'export et les stats — jamais celle du
  // contrat, qui peut être modifiée après coup.
  commissionAppliquee Decimal?  @map("commission_appliquee") @db.Decimal(5, 2)
  deposantPaye        Boolean?  @map("deposant_paye")
  dateVente           DateTime? @map("date_vente")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  boutique     Boutique?     @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)
  categorie    Categorie     @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  statut       Statut        @relation(fields: [statutId], references: [id], onDelete: Restrict)
  contratDepot ContratDepot? @relation(fields: [contratDepotId], references: [id], onDelete: SetNull)

  valeurs    ValeurAttribut[]
  options    ProduitAttributOption[]
  historique HistoriqueStatut[]

  @@index([entrepriseId])
  @@index([boutiqueId])
  @@index([categorieId])
  @@index([statutId])
  @@index([contratDepotId])
  @@index([reference])
  @@map("produit")
}

// Valeurs des attributs TEXT / NUMBER / BOOLEAN.
model ValeurAttribut {
  id                   String   @id @default(cuid())
  produitId            String   @map("produit_id")
  attributDefinitionId String   @map("attribut_definition_id")
  valeurTexte          String?  @map("valeur_texte")
  valeurNombre         Decimal? @map("valeur_nombre") @db.Decimal(12, 3)
  valeurBooleenne      Boolean? @map("valeur_booleenne")

  produit  Produit            @relation(fields: [produitId], references: [id], onDelete: Cascade)
  attribut AttributDefinition @relation(fields: [attributDefinitionId], references: [id], onDelete: Cascade)

  @@unique([produitId, attributDefinitionId])
  @@index([produitId])
  @@index([attributDefinitionId])
  @@map("valeur_attribut")
}

// Valeurs des attributs SELECT (une ligne) et MULTISELECT (plusieurs).
model ProduitAttributOption {
  produitId        String @map("produit_id")
  attributOptionId String @map("attribut_option_id")

  produit Produit        @relation(fields: [produitId], references: [id], onDelete: Cascade)
  option  AttributOption @relation(fields: [attributOptionId], references: [id], onDelete: Cascade)

  @@id([produitId, attributOptionId])
  @@index([produitId])
  @@index([attributOptionId])
  @@map("produit_attribut_option")
}

model HistoriqueStatut {
  id              String   @id @default(cuid())
  produitId       String   @map("produit_id")
  statutId        String   @map("statut_id")
  // Nullable + SetNull : supprimer un employé ne doit pas effacer la trace des
  // changements de statut qu'il a faits.
  changedByUserId String?  @map("changed_by_user_id")
  changedAt       DateTime @default(now()) @map("changed_at")
  note            String?

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  statut  Statut  @relation(fields: [statutId], references: [id], onDelete: Restrict)
  auteur  User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([produitId])
  @@index([statutId])
  @@index([changedByUserId])
  @@map("historique_statut")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String   @id @default(cuid())
  entrepriseId   String   @map("entreprise_id")
  type           String
  contratDepotId String?  @map("contrat_depot_id")
  message        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  contratDepot ContratDepot? @relation(fields: [contratDepotId], references: [id], onDelete: Cascade)

  @@index([entrepriseId])
  @@index([contratDepotId])
  @@map("notification")
}
