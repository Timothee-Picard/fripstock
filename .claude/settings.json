{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npx prisma *)",
      "Bash(npx next *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(curl localhost:*)",
      "Bash(curl http://localhost:*)",
      "Bash(npx commitlint *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx husky *)",
      "Bash(npx lint-staged *)",
      "Bash(git tag)",
      "Bash(git tag -l *)",
      "Bash(git describe *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(./scripts/node-run.sh *)",
      "Bash(./scripts/check-db.sh)",
      "Bash(git stripspace *)",
      "Bash(git check-ignore *)",
      "Bash(docker compose run *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose exec *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker compose down -v)",
      "Bash(npx prisma migrate reset *)",
      "Bash(rm -rf *)",
      "Bash(make release)",
      "Bash(git push --follow-tags *)",
      "Bash(git tag -d *)",
      "Bash(./scripts/release.sh)",
      "Bash(git update-ref *)",
      "Bash(git commit-tree *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-after-edit.sh"
          }
        ]
      }
    ]
  }
}
