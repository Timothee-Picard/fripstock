# Portage des permissions Claude. La décision la plus restrictive prime.
prefix_rule(pattern = ["make"], decision = "allow")
prefix_rule(pattern = ["docker", "compose"], decision = "allow")
prefix_rule(pattern = ["npm", "install"], decision = "allow")
prefix_rule(pattern = ["npm", "run"], decision = "allow")
prefix_rule(pattern = ["npx", "prisma"], decision = "allow")
prefix_rule(pattern = ["npx", "next"], decision = "allow")
prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "add"], decision = "allow")
prefix_rule(pattern = ["git", "commit"], decision = "allow")
prefix_rule(pattern = ["npx", "commitlint"], decision = "allow")
prefix_rule(pattern = ["npx", "eslint"], decision = "allow")
prefix_rule(pattern = ["npx", "prettier"], decision = "allow")
prefix_rule(pattern = ["npx", "tsc"], decision = "allow")
prefix_rule(pattern = ["npx", "husky"], decision = "allow")
prefix_rule(pattern = ["npx", "lint-staged"], decision = "allow")
prefix_rule(pattern = ["git", "tag"], decision = "allow")
prefix_rule(pattern = ["git", "tag", "-l"], decision = "allow")
prefix_rule(pattern = ["git", "describe"], decision = "allow")
prefix_rule(pattern = ["gh", "pr"], decision = "allow")
prefix_rule(pattern = ["gh", "run"], decision = "allow")
prefix_rule(pattern = ["./scripts/node-run.sh"], decision = "allow")
prefix_rule(pattern = ["./scripts/check-db.sh"], decision = "allow")
prefix_rule(pattern = ["git", "stripspace"], decision = "allow")
prefix_rule(pattern = ["git", "check-ignore"], decision = "allow")
prefix_rule(pattern = ["docker", "compose", "run"], decision = "allow")
prefix_rule(pattern = ["docker", "compose", "logs"], decision = "allow")
prefix_rule(pattern = ["docker", "compose", "ps"], decision = "allow")
prefix_rule(pattern = ["docker", "compose", "exec"], decision = "allow")
prefix_rule(pattern = ["git", "push"], decision = "prompt")
prefix_rule(pattern = ["docker", "compose", "down", "-v"], decision = "prompt")
prefix_rule(pattern = ["npx", "prisma", "migrate", "reset"], decision = "prompt")
prefix_rule(pattern = ["rm", "-rf"], decision = "prompt")
prefix_rule(pattern = ["make", "release"], decision = "prompt")
prefix_rule(pattern = ["git", "push", "--follow-tags"], decision = "prompt")
prefix_rule(pattern = ["git", "tag", "-d"], decision = "prompt")
prefix_rule(pattern = ["./scripts/release.sh"], decision = "prompt")
prefix_rule(pattern = ["git", "update-ref"], decision = "prompt")
prefix_rule(pattern = ["git", "commit-tree"], decision = "prompt")
prefix_rule(pattern = ["docker", "compose", "down"], decision = "prompt")
prefix_rule(pattern = ["make", "prod-down"], decision = "prompt")
prefix_rule(pattern = ["make", "seed"], decision = "prompt")
